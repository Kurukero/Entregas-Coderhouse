              "id": "check",
              "leftValue": "={{ typeof $json.result?.summary === 'string' && $json.result.summary.length > 0 && typeof $json.result?.reply === 'string' && $json.result.reply.length > 0 && $json.result.reply.length <= 2000 && ['critica','alta','normal','baja'].includes($json.result.priority) && typeof $json.result.escalate === 'boolean' && $json.result.team === 'soporte_tecnico' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
